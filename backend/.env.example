# 복사해서 backend/.env 로 저장한다. 실제 값은 커밋하지 않는다. 서버 키는 브라우저에 노출하지 않는다.
# 다른 외부 API 키는 해당 담당자가 이름만 추가한다.

# 카카오 로컬 API (REST 키)
KAKAO_REST_API_KEY=
# Gemini 3.5 Flash-Lite(기본 모델, GEMINI_MODEL 로 바꿀 수 있다). 없으면 규칙 해석만 한다
GEMINI_API_KEY=
# TMAP 경로 API. 없으면 경로를 조회하지 않고 이동시간을 '확인 필요'로 둔다
TMAP_API_KEY=
# ODsay 대중교통 경로 API(TMAP 실패 시 예비)
ODSAY_API_KEY=
# 한국관광공사 TourAPI(공공데이터포털 일반 인증키, Decoding). 앱은 쓰지 않는다. 배치 수집(app.batch.cli)과
# 사진 샘플 호출 스크립트가 쓴다. 없으면 배치 수집은 호출하지 않고 FAILED 로 기록·알린다
TOURAPI_SERVICE_KEY=
# 부산광역시 일평균 생활인구수(행정동·시간, DATA-04, 공공데이터포털 일반 인증키, Decoding). 앱은 쓰지 않는다.
# 혼잡 입력 변환 명령(python -m app.modules.crowd.importers living)만 쓴다
DATA04_SERVICE_KEY=
# 한국관광공사 DATA-06 빅데이터_지역별 방문자수·DATA-07 관광지 집중률 예측(공공데이터포털 일반 인증키, Decoding).
# 배치(data06·data07)만 쓴다. 없으면 호출하지 않고 FAILED 로 기록·알린다. 켜는 법은 backend/README.md
DATA06_SERVICE_KEY=
DATA07_SERVICE_KEY=
# 아래는 비우면 기본값(주석의 값)이다. 지역 코드 대응표 기본 위치는 data/seed/crowd/busan_region_codes.csv
# PUBLIC_DATA_TIMEOUT_S=10
# PUBLIC_DATA_PAGE_SIZE=1000
# DATA06_BASELINE_DAYS=28
# DATA06_LAG_DAYS=3
# CROWD_MULTIPLIER_RETENTION_DAYS=365
# CROWD_REGION_CODES_PATH=

# 배치 수집 실패·복구 알림을 JSON 으로 POST 할 주소(선택). 비우면 구조화 로그(ingestion_alert)만 남긴다
ADMIN_ALERT_WEBHOOK_URL=
# 연속 실패 n 회면 마지막 실패 + min(이 값 × 2^(n-1) 분, 수집 주기) 뒤에 다시 시도한다. 비우면 15
BATCH_BACKOFF_BASE_MIN=

# PostgreSQL 접속 URL. 비워 두면 여행·되돌리기 이력을 메모리에 저장한다(재시작하면 사라진다).
# 로컬은 루트 docker-compose.yml 의 db 서비스를 쓴다. 예: postgresql://pinandfill:pinandfill@localhost:5432/pinandfill
DATABASE_URL=
# 장소 데이터 출처: csv(기본, data/samples) 또는 db(places·place_hours, DATABASE_URL·seed-places 필요).
# 앱 시작 때 한 번 읽으므로 DB 를 갱신하면 앱을 다시 시작한다
PLACE_DATA_SOURCE=
# DB 연결 풀·대기 상한. 주석을 풀어 바꾼다. 비워 두거나(`DB_POOL_SIZE=`) 지우면 아래 기본값이다
# 풀 크기 기본은 SQLAlchemy 기본값(5·10)이고, 풀 설정은 SQLite 에는 쓰지 않는다
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# 풀에서 연결을 기다리는 최대 초
# DB_POOL_TIMEOUT=10
# PostgreSQL 만: 행 잠금 대기·문 실행 상한(밀리초, 0 이면 상한 없음)
# DB_LOCK_TIMEOUT_MS=5000
# DB_STATEMENT_TIMEOUT_MS=15000
